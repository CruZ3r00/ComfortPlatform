# Runner delle migrazioni di piattaforma (ADR-0014 §14.5).
#
# Copia in .env (ignorato da git) e compila solo gli ambienti che usi. L'ambiente si sceglie
# sempre esplicitamente, non c'e' un default:
#   npm run db:dry-run -- --env staging
#   npm run db:apply   -- --env staging
# Le variabili gia' presenti nell'ambiente del processo hanno la precedenza su questo file.
#
# Nomi: PLATFORM_<AMBIENTE>_DATABASE_*, con <AMBIENTE> = nome passato a --env in maiuscolo.
#
# Utente: l'AMMINISTRATORE del database (su Supabase `postgres`), mai l'utente di un'app.
# Connessione: diretta (Supabase > Connect > Direct connection) oppure pooler in modalita'
# SESSIONE sulla porta 5432 (utente `postgres.<project-ref>`). Mai il pooler in modalita'
# transazione (6543): il runner tiene un lock di sessione per tutta l'esecuzione.
#
# TLS: con SSL=true serve il certificato CA di Supabase (Project Settings > Database > SSL
# Configuration) in SSL_CA. Senza CA il runner si ferma, a meno di dichiarare
# SSL_REJECT_UNAUTHORIZED=false (connessione cifrata ma NON verificata).
#
# I valori `changeme` sono segnaposto: il runner li rifiuta come se mancassero.

# --- staging ------------------------------------------------------------------
PLATFORM_STAGING_DATABASE_HOST=changeme
PLATFORM_STAGING_DATABASE_PORT=5432
PLATFORM_STAGING_DATABASE_NAME=postgres
PLATFORM_STAGING_DATABASE_USERNAME=postgres
PLATFORM_STAGING_DATABASE_PASSWORD=changeme
PLATFORM_STAGING_DATABASE_SSL=true
PLATFORM_STAGING_DATABASE_SSL_CA=changeme
PLATFORM_STAGING_DATABASE_SSL_REJECT_UNAUTHORIZED=true

# --- produzione ---------------------------------------------------------------
PLATFORM_PRODUCTION_DATABASE_HOST=changeme
PLATFORM_PRODUCTION_DATABASE_PORT=5432
PLATFORM_PRODUCTION_DATABASE_NAME=postgres
PLATFORM_PRODUCTION_DATABASE_USERNAME=postgres
PLATFORM_PRODUCTION_DATABASE_PASSWORD=changeme
PLATFORM_PRODUCTION_DATABASE_SSL=true
PLATFORM_PRODUCTION_DATABASE_SSL_CA=changeme
PLATFORM_PRODUCTION_DATABASE_SSL_REJECT_UNAUTHORIZED=true

# --- sito ComfortService di oggi (solo sorgente di data-migrations/site-copy) -----------
# Utente con cui il backend del sito legge oggi il suo schema; la copia lo legge in sola lettura.
PLATFORM_SITE_LIVE_DATABASE_HOST=changeme
PLATFORM_SITE_LIVE_DATABASE_PORT=5432
PLATFORM_SITE_LIVE_DATABASE_NAME=postgres
PLATFORM_SITE_LIVE_DATABASE_USERNAME=changeme
PLATFORM_SITE_LIVE_DATABASE_PASSWORD=changeme
PLATFORM_SITE_LIVE_DATABASE_SSL=true
PLATFORM_SITE_LIVE_DATABASE_SSL_CA=changeme
PLATFORM_SITE_LIVE_DATABASE_SSL_REJECT_UNAUTHORIZED=true
