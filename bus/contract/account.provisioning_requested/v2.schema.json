{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:comfort-platform:bus:account.provisioning_requested:v2",
  "title": "account.provisioning_requested v2",
  "description": "Attivita' collegata a ComforTables: creazione in ComforTables (ADR-0013 §13.8). Come la v1, ma plan_code e' null finche' non esistono i piani (Fase 3): prima dei piani l'account la pubblica al primo collegamento dell'attivita' a ComforTables",
  "type": "object",
  "required": [
    "person_id",
    "plan_code",
    "owner_email",
    "owner_name",
    "staff_default_password_hash"
  ],
  "properties": {
    "person_id": {
      "$ref": "urn:comfort-platform:bus:common#/$defs/uuid"
    },
    "plan_code": {
      "anyOf": [
        {
          "$ref": "urn:comfort-platform:bus:common#/$defs/text"
        },
        {
          "type": "null"
        }
      ]
    },
    "owner_email": {
      "$ref": "urn:comfort-platform:bus:common#/$defs/email"
    },
    "owner_name": {
      "$ref": "urn:comfort-platform:bus:common#/$defs/text"
    },
    "staff_default_password_hash": {
      "$ref": "urn:comfort-platform:bus:common#/$defs/jwe"
    }
  }
}
